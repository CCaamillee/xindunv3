DASHSCOPE_API_KEY = "sk-替换为你的百炼Key"
BAILIAN_COMPATIBLE_URL = "https://dashscope.aliyuncs.com/compatible-mode/v1"
BAILIAN_MODEL = "qwen3.7-plus"
BAILIAN_KNOWLEDGE_MODEL = "deepseek-v4-flash"
BAILIAN_CONTEXT_MODEL = "qwen3.7-plus"
CLINICAL_CONTEXT_LLM_ENABLED = "1"
CLINICAL_CONTEXT_TIMEOUT_SECONDS = "12"
KNOWLEDGE_TIMEOUT_SECONDS = "15"

# 心脏破裂预测模型使用 OpenAI 兼容接口。若模型不与网页部署在同一台服务器，
# 请把 127.0.0.1 替换为模型服务器可从网页服务器访问的内网地址。
CARDIAC_RISK_URLS = "http://127.0.0.1:8000/v1,http://127.0.0.1:8001/v1"
CARDIAC_RISK_MODEL = "cardiac-rupture-qwen38"
CARDIAC_RISK_API_KEY = "replace-with-risk-service-key"
CARDIAC_RISK_MAX_TOKENS = "1024"
PREDICTION_RESULTS_PATH = "model-results/clean_非破裂完整版（15天窗口）_predictions.jsonl"

# 默认读取项目根目录工作簿；部署环境可按需覆盖。
PATIENT_WORKBOOK_XLSX = "clean_非破裂完整版（15天窗口）.xlsx"

# 部署为私密演示时启用；未配置则保持本地开放访问。
APP_ACCESS_PASSWORD = "replace-with-a-strong-shared-password"
